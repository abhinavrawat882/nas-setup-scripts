# Copy to config.env and edit before running setup.sh
#   cp config.env.example config.env

# Absolute path on your OMV data disk where Docker + media will live.
# Examples:
#   NAS_ROOT=/srv/dev-disk-by-uuid-XXXXXXXX/nas
#   NAS_ROOT=/export/nas
NAS_ROOT=/srv/nas

# LinuxServer-style user/group for container file ownership.
# On OMV, PUID is often your user id; PGID is often "users" (100).
PUID=1000
PGID=100

# Timezone, e.g. America/New_York, Asia/Kolkata, Europe/London
TZ=UTC

# Host path for media libraries (movies/tv/music live under here by default).
# Defaults to ${NAS_ROOT}/media if unset.
# MEDIA_PATH=/srv/nas/media

# Host ports (change if something else already uses them)
PORTAINER_PORT=9000
JELLYFIN_PORT=8096
VAULTWARDEN_PORT=8080

# Set to false after you create your Vaultwarden account, then redeploy.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Docker Compose project name
COMPOSE_PROJECT_NAME=nas
