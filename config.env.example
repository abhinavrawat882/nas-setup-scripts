# Copy to config.env and edit before running setup.sh
#   cp config.env.example config.env

# Absolute path on your OMV data disk where Docker + media will live.
# Examples:
#   NAS_ROOT=/srv/dev-disk-by-uuid-XXXXXXXX/nas
#   NAS_ROOT=/export/nas
NAS_ROOT=/srv/nas

# LinuxServer-style user/group for container file ownership.
# On OMV, PUID is often your user id; PGID is often "users" (100).
PUID=1000
PGID=100

# Timezone, e.g. America/New_York, Asia/Kolkata, Europe/London
TZ=UTC

# Host path for media libraries (movies/tv/music live under here by default).
# Defaults to ${NAS_ROOT}/media if unset.
# MEDIA_PATH=/srv/nas/media

# Tailscale IP on this NAS. Portainer, Vaultwarden, RabbitMQ, and Registry bind
# here only (not 0.0.0.0) so Docker does not bypass UFW onto the LAN.
# Jellyfin stays on the LAN for local app/TV discovery.
TAILSCALE_IP=100.92.27.123

# Host ports (change if something else already uses them)
PORTAINER_PORT=9000
JELLYFIN_PORT=8096
VAULTWARDEN_PORT=8080

# Set to false after you create your Vaultwarden account, then redeploy.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# Docker Compose project name (core stack)
COMPOSE_PROJECT_NAME=nas

# --- Projects stack (sudo ./scripts/05-deploy-projects.sh) ---
PROJECTS_COMPOSE_PROJECT_NAME=nas-projects

RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
# Change these before first deploy
RABBITMQ_USER=nas
RABBITMQ_PASS=changeme

REGISTRY_PORT=5000
REGISTRY_USER=nas
REGISTRY_PASS=changeme
# How many newest tags per repo to keep when running scripts/06-registry-gc.sh --prune
REGISTRY_KEEP_TAGS=5

# TellegramService (RabbitMQ → Telegram). Required for the tellegram container.
# Create a bot via @BotFather, then get chat id from:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Trading Advisor (optional — push image first, then 05-deploy-projects.sh)
# Dashboard binds Tailscale only. Port 5100 avoids clash with Registry on :5000.
AI_TRADING_PORT=5100
GEMINI_API_KEY=

# --- HomeSecurity (optional — push images first, then 09-setup-homesecurity.sh) ---
# Dashboard is on the LAN (like Jellyfin). API is Tailscale-only.
HOMESECURITY_API_PORT=5101
HOMESECURITY_DASHBOARD_PORT=8081
HOMESECURITY_POSTGRES_PASSWORD=changeme
# Shared folder (or any host path) for MP4 clips. Override to your OMV share.
# HOMESECURITY_RECORDINGS_PATH=/srv/nas/shared/homesecurity-recordings
# Optional extra CORS origin if you bookmark the dashboard by LAN hostname:
# HOMESECURITY_DASHBOARD_LAN_URL=http://192.168.1.10:8081
HOMESECURITY_TELEGRAM_ENABLED=true

# --- Logging stack (sudo ./scripts/08-deploy-logging.sh) ---
LOGGING_COMPOSE_PROJECT_NAME=nas-logging
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Change this before first deploy
GRAFANA_ADMIN_PASSWORD=changeme
